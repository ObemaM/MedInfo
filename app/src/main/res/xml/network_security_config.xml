<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Адрес сервера задаётся администратором в настройках и может быть любым,
      поэтому cleartext (HTTP) разрешаем глобально, а не для одного хардкод-IP.
      Иначе Android блокирует соединение с любым новым IP по сетевой политике.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
