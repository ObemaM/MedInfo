<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:backgroundTint="@color/blue_3"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_gray_1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/call_number_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/menu_text_color_2"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Неизвестно" />

            <LinearLayout
                android:id="@+id/badges_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_status_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/white_1"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Неизвестно" />

            <TextView
                android:id="@+id/decision_badge_unused"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/rounded_status_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/white_1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Отклонена"
                tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/border_gray_1" />

        <!-- Решение по консультации — первым блоком под чертой, только в архиве.
             Статус госпитализации уже в бейдже справа сверху, как у активных. -->
        <TextView
            android:id="@+id/archive_status_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Решение:"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/decision_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/menu_text_color_2"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Принята"
            tools:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Пациент:"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/patient_details_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            tools:text="Неизвестно" />

        <TextView
            android:id="@+id/birth_day_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Дата рождения:"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/birth_day_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="01.01.1980"
            tools:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Повод:"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/call_reason_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            tools:text="Неизвестно" />

        <TextView
            android:id="@+id/diagnosis_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Диагноз:"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/diagnosis_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="ОКС"
            tools:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Адрес:"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/call_address_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            tools:text="Неизвестно" />

        <TextView
            android:id="@+id/time_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Дата неизвестна"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/decision_timer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_status_background"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/white_1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Осталось на решение: 12:34"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
