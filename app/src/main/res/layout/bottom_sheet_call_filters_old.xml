<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@color/background_2"
    app:cardBackgroundColor="@color/background_2"
    app:cardCornerRadius="0dp"
    app:strokeColor="@color/border_gray_1"
    app:strokeWidth="1dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Фильтры"
                    android:textColor="@color/gray_1"
                    android:textSize="20sp" />

                <ImageButton
                    android:id="@+id/close_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Закрыть"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/gray_1" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/border_gray_1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Срочность"
                android:textColor="@color/gray_1"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/urgency_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/urgency_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="от"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/urgency_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/urgency_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="до"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Пол"
                android:textColor="@color/gray_1"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sex_toggle_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sex_any_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Любой"
                    android:textColor="@color/sex_toggle_text_colors"
                    app:backgroundTint="@color/sex_toggle_background_tint"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/sex_toggle_stroke_colors" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sex_male_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Муж"
                    android:textColor="@color/sex_toggle_text_colors"
                    app:backgroundTint="@color/sex_toggle_background_tint"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/sex_toggle_stroke_colors" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sex_female_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Жен"
                    android:textColor="@color/sex_toggle_text_colors"
                    app:backgroundTint="@color/sex_toggle_background_tint"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/sex_toggle_stroke_colors" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Возраст"
                android:textColor="@color/gray_1"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/age_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/age_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="от"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/age_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/age_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="до"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Дата"
                android:textColor="@color/gray_1"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/date_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/date_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:hint="от"
                        android:inputType="none"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/date_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/date_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:hint="до"
                        android:inputType="none"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Номер вызова"
                android:textColor="@color/gray_1"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Часть до /"
                android:textColor="@color/gray_1"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/call_day_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/call_day_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="от"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/call_day_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/call_day_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="до"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Часть после /"
                android:textColor="@color/gray_1"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/call_year_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/call_year_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="от"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/call_year_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/call_year_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="до"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reset_filters_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="Сбросить"
                    android:textColor="@color/black_1"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_gray_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/apply_filters_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/main_1"
                    android:text="Применить"
                    android:textColor="@color/white_1"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</com.google.android.material.card.MaterialCardView>
