<?xml version="1.0" encoding="utf-8"?>
<!--
  Раскрывающаяся карточка "Состояние пациента". Подключается через <include> на экранах
  IncomingCallActivity и HospitalizationDetailsActivity, чтобы все три категории вызовов
  (Требуют решения, Активные, Архив) выглядели одинаково.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/patient_condition_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:visibility="gone"
        app:cardBackgroundColor="@color/background_2"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_gray_1"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Состояние пациента"
                android:textColor="@color/gray_1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/patient_condition_arrow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Раскрыть состояние пациента"
                android:src="@drawable/ic_expand_more_24"
                app:tint="@color/main_1" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/patient_condition_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
