<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/background_2"
    app:cardCornerRadius="24dp"
    app:strokeColor="@color/border_gray_1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Pinned header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/filters_title"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:gravity="center|start"
                android:text="@string/filters_name"
                android:textColor="@color/gray_1"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/close_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/close_button"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/close_button_background"
                android:padding="2dp"
                android:src="@drawable/ic_close_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/gray_1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/divider_header"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_gray_1" />

        <!-- Scrollable middle -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/urgency_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Срочность"
                    android:textColor="@color/gray_1"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/urgency_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toStartOf="@+id/urgency_to_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/urgency_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/urgency_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="от"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/urgency_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/urgency_from_layout"
                    app:layout_constraintTop_toBottomOf="@+id/urgency_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/urgency_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="до"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/sex_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Пол"
                    android:textColor="@color/gray_1"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@+id/urgency_from_layout" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/sex_toggle_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/sex_label"
                    app:selectionRequired="false"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sex_any_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Любой"
                        android:textColor="@color/sex_toggle_text_colors"
                        app:backgroundTint="@color/sex_toggle_background_tint"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/sex_toggle_stroke_colors" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sex_male_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Муж"
                        android:textColor="@color/sex_toggle_text_colors"
                        app:backgroundTint="@color/sex_toggle_background_tint"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/sex_toggle_stroke_colors" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sex_female_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Жен"
                        android:textColor="@color/sex_toggle_text_colors"
                        app:backgroundTint="@color/sex_toggle_background_tint"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/sex_toggle_stroke_colors" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/age_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Возраст"
                    android:textColor="@color/gray_1"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@+id/sex_toggle_group" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/age_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toStartOf="@+id/age_to_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/age_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/age_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="от"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/age_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/age_from_layout"
                    app:layout_constraintTop_toBottomOf="@+id/age_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/age_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="до"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/date_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Дата"
                    android:textColor="@color/gray_1"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@+id/age_from_layout" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/date_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:endIconDrawable="@drawable/ic_clear_24"
                    app:endIconMode="custom"
                    app:endIconTint="@color/border_gray_2"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toStartOf="@+id/date_to_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/date_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/date_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:hint="от"
                        android:inputType="none"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/date_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:endIconDrawable="@drawable/ic_clear_24"
                    app:endIconMode="custom"
                    app:endIconTint="@color/border_gray_2"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/date_from_layout"
                    app:layout_constraintTop_toBottomOf="@+id/date_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/date_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:hint="до"
                        android:inputType="none"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/call_number_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Номер вызова"
                    android:textColor="@color/gray_1"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@+id/date_from_layout" />

                <TextView
                    android:id="@+id/call_day_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Суточный номер"
                    android:textColor="@color/gray_1"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@+id/call_number_label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/call_day_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toStartOf="@+id/call_day_to_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/call_day_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/call_day_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="от"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/call_day_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/call_day_from_layout"
                    app:layout_constraintTop_toBottomOf="@+id/call_day_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/call_day_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="до"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/call_year_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Годовой номер"
                    android:textColor="@color/gray_1"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@+id/call_day_from_layout" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/call_year_from_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toStartOf="@+id/call_year_to_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/call_year_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/call_year_from_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="от"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/call_year_to_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxStrokeColor="@color/search_text_input_colors"
                    app:hintTextColor="@color/search_text_input_colors"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/call_year_from_layout"
                    app:layout_constraintTop_toBottomOf="@+id/call_year_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/call_year_to_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="до"
                        android:inputType="number"
                        android:textColor="@color/gray_1" />

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/divider_footer"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_gray_1" />

        <!-- Pinned footer -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/footer_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_filters_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:text="Сбросить"
                android:textColor="@color/black_1"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toStartOf="@+id/apply_filters_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/border_gray_2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/apply_filters_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/main_1"
                android:text="Применить"
                android:textColor="@color/white_1"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/reset_filters_button"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
