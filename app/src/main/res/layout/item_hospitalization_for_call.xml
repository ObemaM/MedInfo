<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:backgroundTint="@color/blue_3"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_gray_1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/call_number_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/menu_text_color_2"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Неизвестно" />

        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_status_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/white_1"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Неизвестно" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пациент:"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/patient_details_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            tools:text="Неизвестно" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Причина:"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/call_reason_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            tools:text="Неизвестно" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Адрес:"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/call_address_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            tools:text="Неизвестно" />

        <TextView
            android:id="@+id/time_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Дата неизвестна"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/urgency_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Срочность неизвестна"
            android:textColor="@color/menu_text_color_1"
            android:textStyle="italic" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>