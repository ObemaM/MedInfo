<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MedInfo" parent="Base.Theme.MedInfo">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/main_1</item>
        <item name="colorPrimaryContainer">@color/blue_2</item>

        <item name="colorSecondary">@color/menu_blue_2</item>
        <item name="colorSecondaryContainer">@color/blue_3</item>

        <item name="colorTertiary">@color/main_1</item>
        <item name="colorTertiaryContainer">@color/blue_3</item>

        <item name="colorSurface">@color/background_1</item>
        <item name="colorSurfaceVariant">@color/background_2</item>

        <item name="colorOnSurface">@color/black_1</item>
        <item name="colorOnSurfaceVariant">@color/gray_1</item>
        <item name="colorOnBackground">@color/black_1</item>
        <item name="colorOnPrimary">@color/white_1</item>
        <item name="colorOnSecondary">@color/white_1</item>

        <item name="android:colorBackground">@color/background_1</item>
        <item name="android:windowBackground">@color/background_1</item>
        <item name="android:statusBarColor">@color/background_1</item>
        <item name="android:navigationBarColor">@color/background_1</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>

        <item name="bottomSheetDialogTheme">@style/App.BottomSheetDialogTheme</item>

        <item name="colorError">@color/red_1</item>
    </style>
</resources>